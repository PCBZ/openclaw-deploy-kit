# Secrets are loaded automatically from ../../.env via .envrc (direnv).
# You do NOT need to set secrets here — just configure the options below.
#
# Required keys in .env:
#   DO_TOKEN, TELEGRAM_BOT_TOKEN, OPENCLAW_GATEWAY_TOKEN
#   (DO_TOKEN is reused as the DO Inference API key — no separate key needed)
# Optional keys in .env:
#   BRAVE_API_KEY, TELEGRAM_OWNER_ID

# ── App Platform ─────────────────────────────────────────────
# Regions: tor (Toronto), sfo (San Francisco), nyc (New York), sgp (Singapore), ams (Amsterdam), fra (Frankfurt)
region = "tor"

# Instance sizes: apps-s-1vcpu-1gb=$10/mo, apps-s-1vcpu-2gb=$25/mo, apps-s-2vcpu-4gb=$50/mo
instance_size = "apps-s-1vcpu-1gb"
